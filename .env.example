[TEMPLATE]
# Deriv API Configuration
# Register your application at https://developers.deriv.com/dashboard
# Then copy this file to .env.local and fill in your credentials.

# ─── Required (Web App) ──────────────────────────────────────
# App ID from the Deriv developer portal (this is your OAuth client_id)
DERIV_APP_ID=your_deriv_app_id

# ─── OAuth 2.0 Configuration ─────────────────────────────────
# Redirect URI registered in the Deriv developer dashboard
# Must match exactly — including protocol, domain, and path
DERIV_REDIRECT_URI=http://localhost:3000/api/deriv/callback

# ─── Optional (Web App) ──────────────────────────────────────
# Public App ID for client-side features (if needed)
NEXT_PUBLIC_DERIV_APP_ID=your_deriv_app_id
# Numeric WebSocket App ID for Core API (profit_table, balance, portfolio).
# If not set, auto-resolves from DERIV_APP_ID numeric prefix or defaults to 1001.
# DERIV_CORE_APP_ID=12345

# ─── Python Bot: Bridge Mode (default) ───────────────────────
# Requires the Next.js app to be running and logged in.
# Bot calls localhost:3000/api/deriv/bot-session to get auth.
DTRADER_BRIDGE_URL=http://localhost:3000
USE_BRIDGE=1

# ─── Python Bot: PAT Mode (standalone) ───────────────────────
# Alternative: skip OAuth entirely, use a Personal Access Token.
# Get one at https://app.deriv.com/account/api-token
# Set USE_BRIDGE=0 to use this mode.
# USE_BRIDGE=0
# PAT_TOKEN=your_personal_access_token_here

# ─── Python Bot: Trading Settings ────────────────────────────
# ACCOUNT_TYPE=demo  # "demo" or "real" (default: demo)
